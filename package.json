{
  "name": "college-journal",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "dev": "node dev/server.js",
    "dev:reset": "node dev/server.js --reset",
    "dev:real": "node dev/server.js --real",
    "dev:lesson": "node dev/server.js --reset --lesson-now",
    "build:gas": "node scripts/build-gas.js",
    "serve": "node backend/node/server.js",
    "serve:init": "node backend/node/server.js --init",
    "serve:admin-password": "node backend/node/server.js --admin-password",
    "serve:backup": "node backend/node/server.js --backup",
    "serve:demo": "node backend/node/server.js --demo",
    "serve:demo-wipe": "node backend/node/server.js --demo --wipe",
    "serve:restore": "node backend/node/supervisor.js --restore",
    "serve:start": "wscript scripts/serve-hidden.vbs",
    "serve:stop": "node backend/node/supervisor.js --stop",
    "serve:status": "node backend/node/supervisor.js --status"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "esbuild": "^0.28.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
